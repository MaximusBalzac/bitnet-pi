#!/usr/bin/env bash
# bitnet — one-stop launcher for Microsoft BitNet (bitnet.cpp) on a Raspberry Pi (ARM64).
#
#   bitnet setup            install deps, clone + build BitNet, download the model (idempotent)
#   bitnet chat             interactive chat in the terminal
#   bitnet serve [port]     OpenAI-compatible server + web UI (default 8081, localhost only)
#   bitnet stop             stop the server
#   bitnet status           show install + server state
#   bitnet bench            tokens/sec benchmark
#
# BitNet is pinned to a known-good commit. Newer BitNet versions (July 2026+) moved the
# optimized I2_S kernel to x86 only and run slowly / incorrectly on ARM with this model.
#
# Env overrides: BITNET_HOME, BITNET_REF, BITNET_MODEL_DIR, BITNET_THREADS, BITNET_CTX, BITNET_HOST.
set -euo pipefail

BASE="${BITNET_BASE:-$HOME/bitnet-pi}"
SRC="${BITNET_HOME:-$BASE/BitNet}"
REF="${BITNET_REF:-c17d1c5d77c48af7d6fb29c9f28a3da0277fc394}"
MODEL_DIR="${BITNET_MODEL_DIR:-$BASE/models}"
MODEL="$MODEL_DIR/ggml-model-i2_s.gguf"
MODEL_URL="https://huggingface.co/microsoft/bitnet-b1.58-2B-4T-gguf/resolve/main/ggml-model-i2_s.gguf"
THREADS="${BITNET_THREADS:-4}"
CTX="${BITNET_CTX:-4096}"
HOST="${BITNET_HOST:-127.0.0.1}"
PIDFILE="$BASE/server.pid"
LOGFILE="$BASE/server.log"
REPO_URL="https://github.com/microsoft/BitNet.git"
CLI="$SRC/build/bin/llama-cli"
SERVER="$SRC/build/bin/llama-server"
BENCH="$SRC/build/bin/llama-bench"

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

need_built() {
  [[ -x "$CLI" && -x "$SERVER" ]] || die "not built yet — run: bitnet setup"
  [[ -f "$MODEL" ]] || die "model missing at $MODEL — run: bitnet setup"
}

cmd_setup() {
  [[ "$(uname -m)" == "aarch64" ]] || die "this launcher targets ARM64 (aarch64) only"
  mkdir -p "$BASE" "$MODEL_DIR"

  if ! command -v clang >/dev/null || ! command -v cmake >/dev/null || ! command -v git >/dev/null; then
    say "Installing build tools (needs sudo)"
    sudo apt-get install -y clang cmake git curl
  fi

  if [[ ! -e "$SRC/.git" ]]; then
    say "Cloning BitNet"
    git clone "$REPO_URL" "$SRC"
    git -C "$SRC" checkout -q "$REF"
  fi
  say "Fetching submodules"
  git -C "$SRC" submodule update --init --recursive --depth 1

  if [[ ! -x "$CLI" || ! -x "$SERVER" || ! -x "$BENCH" ]]; then
    say "Generating kernel header"
    ( cd "$SRC" && python3 utils/codegen_tl1.py --model bitnet_b1_58-3B \
        --BM 160,320,320 --BK 64,128,64 --bm 32,64,32 >/dev/null )
    say "Building (20-30 min on 4 cores)"
    ( cd "$SRC" && export CC=clang CXX=clang++ \
      && cmake -B build -DBITNET_ARM_TL1=OFF -DCMAKE_BUILD_TYPE=Release \
           -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
           -DLLAMA_BUILD_COMMON=ON -DLLAMA_BUILD_SERVER=ON \
      && cmake --build build --config Release -j"$(nproc)" \
           --target llama-cli llama-server llama-bench )
  fi

  if [[ ! -f "$MODEL" ]]; then
    say "Downloading model (~1.2 GB)"
    curl -fL --retry 3 -C - -o "$MODEL.part" "$MODEL_URL"
    mv "$MODEL.part" "$MODEL"
  fi
  say "Done. Try: bitnet chat"
}

cmd_chat() {
  need_built
  exec "$CLI" -m "$MODEL" -t "$THREADS" -c "$CTX" -cnv -p "You are a helpful assistant"
}

server_pid() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then cat "$PIDFILE"; fi
}

cmd_serve() {
  need_built
  local port="${1:-8081}"
  [[ -z "$(server_pid)" ]] || die "already running (pid $(server_pid)); use: bitnet stop"
  nohup "$SERVER" -m "$MODEL" --host "$HOST" --port "$port" -t "$THREADS" -c "$CTX" \
    >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  say "Server started (pid $!) at http://$HOST:$port  — log: $LOGFILE"
  [[ "$HOST" == "127.0.0.1" ]] && echo "   (localhost only; set BITNET_HOST=0.0.0.0 to expose on the network)"
  return 0
}

cmd_stop() {
  local pid; pid="$(server_pid)"
  [[ -n "$pid" ]] || { say "Not running."; return 0; }
  kill "$pid" && rm -f "$PIDFILE"
  say "Stopped."
}

cmd_status() {
  echo "source: $SRC  $([[ -e $SRC/.git ]] && echo present || echo MISSING)"
  echo "binary: $([[ -x $CLI && -x $SERVER ]] && echo built || echo 'not built')"
  echo "model:  $([[ -f $MODEL ]] && du -h "$MODEL" | cut -f1 || echo MISSING)  ($MODEL)"
  echo "server: $([[ -n "$(server_pid)" ]] && echo "running pid $(server_pid)" || echo stopped)"
}

cmd_bench() {
  need_built
  [[ -x "$BENCH" ]] || die "llama-bench not built — run: bitnet setup"
  "$BENCH" -m "$MODEL" -t "$THREADS" -p 64 -n 32
}

case "${1:-}" in
  setup)  cmd_setup ;;
  chat)   cmd_chat ;;
  serve)  shift; cmd_serve "$@" ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  bench)  cmd_bench ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
